# Team Pulse — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# Required: Anthropic API key for Agent SDK scripts (compile, reports, chat)
ANTHROPIC_API_KEY=your-key-here

# Optional: Claude model used by all Agent SDK scripts. Falls back to
# claude-haiku-4-5-20251001 if unset. Override for quality experiments
# (e.g. claude-sonnet-4-6 for richer synthesis on /ask or compile runs).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: GitHub token for private repos (gh CLI uses its own auth by default)
GITHUB_TOKEN=

# Repos to track (comma-separated owner/repo). Falls back to DEFAULT_REPOS in team_pulse.py
TEAM_PULSE_REPOS=karpathy/autoresearch,garrytan/gstack

# Timezone for scheduling and display (used by pipeline and reports)
TEAM_PULSE_TIMEZONE=Asia/Bangkok

# Web app: GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Web app: NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
